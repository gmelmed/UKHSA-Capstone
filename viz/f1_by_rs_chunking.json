{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "url": "https://raw.githubusercontent.com/gmelmed/UKHSA-Capstone/refs/heads/main/data/7-data-for-viz/performance_with_features.csv"
    },
    "transform": [{"filter": "datum.readability_score > 0"}],
    "mark": {"type": "circle", "size": 100},
    "encoding": {
      "x": {
        "field": "readability_score",
        "type": "quantitative",
        "scale": {"zero": false},
        "axis":{
          "format":"~s",
          "tickCount":4
        },
        "title":"Readability Score"
      },
      "y": {
        "field": "F1 (Chunking)",
        "type": "quantitative",
        "scale": {"zero": false},
        "title": "F1 Score"
      },
      "color": {"field": "region"}
    },
    "config": {
      "font": "Montserrat, sans-serif",
      "view": {"stroke": "transparent"},
      "background": "#ffffff",
      "range": {
        "category": {"scheme":"observable10"}
      },
      "point": {"filled": true, "opacity": 0.95},
      "axis": {
        "labelColor": "#676A86",
        "labelFontSize": 12,
        "labelFont": "Montserrat, sans-serif",
        "tickColor": "#676A86",
        "tickOpacity": 0.5,
        "domainColor": "#676A86",
        "domainOpacity": 0.5,
        "gridColor": "#676A86",
        "gridDash": [2, 2],
        "gridOpacity": 0.5,
        "title": null,
        "titleColor": "#676A86",
        "titleOpacity": 0.8,
        "tickSize": 4
      },
      "axisX": {"grid": false},
      "axisXTemporal": {"grid": false},
      "axisYQuantitative": {
        "gridColor": "#676A86",
        "gridDash": [1, 5],
        "gridOpacity": 0.5,
        "ticks": false,
        "labelPadding": 5,
        "tickCount": 8,
        "titleAngle": 0,
        "titleAlign": "left",
        "titleBaseline": "bottom",
        "titleX": 0,
        "titleY": -5
      },
      "legend": {
        "titleFont": "Montserrat, sans-serif",
        "titleFontSize": 14,
        "titleColor": "#1a1a1a",
        "title": null,
        "labelColor": "#1a1a1a",
        "labelFontSize": 12
      },
      "title": {
        "font": "Montserrat, sans-serif",
        "fontSize": 16,
        "color": "#1a1a1a",
        "subtitleFontSize": 14,
        "subtitleColor": "#676A86"
      }
    },
    "height": 400,
    "width": 600
  }