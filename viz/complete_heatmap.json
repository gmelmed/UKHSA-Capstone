{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "url": "https://raw.githubusercontent.com/gmelmed/UKHSA-Capstone/refs/heads/main/data/7-data-for-viz/heatmap_data.csv"
    },
    "config": {
      "font": "Montserrat, sans-serif",
      "view": {"stroke": "transparent"},
      "background": "#ffffff",
      "range": {
        "category": ["#E07A5F","#81B29A",  "#3D405B", "#F2CC8F", "#F4F1DE"]
      },
      "point": {"filled": true, "opacity": 0.95},
      "axis": {
        "labelColor": "#676A86",
        "labelFontSize": 12,
        "labelFont": "Montserrat, sans-serif",
        "tickColor": "#676A86",
        "tickOpacity": 0.5,
        "domainColor": "#676A86",
        "domainOpacity": 0.5,
        "gridColor": "#676A86",
        "gridDash": [2, 2],
        "gridOpacity": 0.5,
        "title": null,
        "titleColor": "#676A86",
        "titleOpacity": 0.8,
        "tickSize": 4
      },
      "axisX": {"labelAngle": -45},
      "axisXTemporal": {"grid": false},
      "axisYQuantitative": {
        "gridColor": "#676A86",
        "gridDash": [1, 5],
        "gridOpacity": 0.5,
        "ticks": false,
        "labelPadding": 5,
        "tickCount": 8,
        "titleAngle": 0,
        "titleAlign": "left",
        "titleBaseline": "bottom",
        "titleX": 0,
        "titleY": -5
      },
      "legend": {
        "titleFont": "Montserrat, sans-serif",
        "titleFontSize": 14,
        "titleColor": "#1a1a1a",
        "title": null,
        "labelColor": "#1a1a1a",
        "labelFontSize": 12
      },
      "title": {
        "font": "Montserrat, sans-serif",
        "fontSize": 16,
        "color": "#1a1a1a",
        "subtitleFontSize": 14,
        "subtitleColor": "#676A86"
      }
    },
    "layer": [
      {
        "mark": "rect",
        "encoding": {
          "x": {
            "field": "question",
            "type": "nominal",
            "sort": [
              "One Health",
              "Human Health",
              "Animal Health",
              "Environment",
              "Food Security",
              "Progress Reporting",
              "Time-bound Targets",
              "Quantitative Targets",
              "Budget Allocation",
              "Future Budget Assessment",
              "Muli-sectoral Committee",
              "New Laws/Regulations",
              "Professional Training",
              "Public Awareness",
              "International Collaboration",
              "Surveillance",
              "Emergent Resistance Detection",
              "IPC",
              "OIE/FAO Standards",
              "Antibiotic Prescription and Dispensation",
              "Rational Antibiotic Use Laws",
              "Research and Development"
            ]
          },
          "y": {"field": "country_name", "type": "nominal"},
          "color": {
            "field": "answer",
            "type": "nominal",
            "title": "Answer",
            "legend": {
                  "orient": "top"
              }
          }
        }
      }
    ],
    "height": 1000,
    "width": 600
  }